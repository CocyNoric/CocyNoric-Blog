# The exact HTTPS origin presented to browsers. Separate multiple origins with commas.
BLOG_PUBLIC_ORIGINS=https://blog.example.com
BLOG_COOKIE_SECURE=true

# Use 1 only when one trusted reverse proxy is the sole path to the container.
# Keep 0 if the mapped port is directly reachable by untrusted clients.
BLOG_TRUST_PROXY_HOPS=1

# Bind only to the Ubuntu host by default so Caddy/Nginx can proxy to it.
BLOG_BIND_ADDRESS=127.0.0.1
BLOG_HOST_PORT=3000

# Set these to `id -u <runner-user>` and `id -g <runner-user>` on the deploy host.
BLOG_UID=1000
BLOG_GID=1000
