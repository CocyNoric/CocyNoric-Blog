{
  "name": "cocynoric-blog",
  "version": "1.0.0",
  "description": "A self-hosted Material Design 3 blog with Markdown and LaTeX support",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build && vite build --ssr src/server/index.ts --outDir dist/server/server && vite build --ssr scripts/admin.ts --outDir dist/server/admin",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "admin:create": "tsx scripts/admin.ts create",
    "admin:change-password": "tsx scripts/admin.ts change-password"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "katex": "^0.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "unified": "^11.0.5",
    "write-file-atomic": "^8.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
